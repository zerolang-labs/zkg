use zkg.github

use zkg.installer

fn usage(world: World) -> Void raises {
    check world.err.write("usage: zkg install\n")
    check world.err.write("       zkg update\n")
    check world.err.write("       zkg search [query]\n")
    check world.err.write("       zkg add https://github.com/user/repo\n")
    check world.err.write("       zkg add <alias>\n")
    check world.err.write("       zkg install <alias>\n")
    check world.err.write("       zkg uninstall <command>\n")
    check world.err.write("       zkg remove <namespace>\n")
}

pub fn run(world: World) -> Void raises {
    let command: Maybe<String> = std.args.get(1)
    if !command.has {
        check usage(world)
        return
    }
    if std.mem.eql(command.value, "install") {
        let spec: Maybe<String> = std.args.get(2)
        if spec.has {
            check add(world, spec.value)
            return
        }
        check install(world)
        return
    }
    if std.mem.eql(command.value, "search") {
        let query: Maybe<String> = std.args.get(2)
        if query.has {
            check search(world, query.value)
        } else {
            check search(world, "")
        }
        return
    }
    if std.mem.eql(command.value, "update") {
        check update(world)
        return
    }
    if std.mem.eql(command.value, "add") {
        let url: Maybe<String> = std.args.get(2)
        if !url.has {
            check usage(world)
            return
        }
        check add(world, url.value)
        return
    }
    if std.mem.eql(command.value, "uninstall") {
        let command_name: Maybe<String> = std.args.get(2)
        if !command_name.has {
            check usage(world)
            return
        }
        check uninstall(world, command_name.value)
        return
    }
    if std.mem.eql(command.value, "remove") {
        let namespace: Maybe<String> = std.args.get(2)
        if !namespace.has {
            check usage(world)
            return
        }
        check remove(world, namespace.value)
        return
    }
    check usage(world)
}
