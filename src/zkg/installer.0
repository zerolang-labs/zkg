fn ensure_dir(path: String) -> Void {
    if !std.fs.exists(path) {
        std.fs.makeDir(path)
    }
}

fn write_chunk(file: mutref<File>, text: String) -> Void raises {
    check std.fs.writeAllOrRaise(file, std.mem.span(text))
}

fn write_http_body(path: String, response: Span<u8>, result: HttpResult) -> Void raises {
    let fs: Fs = std.fs.host()
    var file: owned<File> = check std.fs.createOrRaise(fs, path)
    var byte: [1]u8 = [0]
    let offset: usize = std.http.responseBodyOffset(response)
    let len: usize = std.http.resultBodyLen(result)
    var index: usize = 0
    while index < len {
        byte[0] = response[offset + index]
        check std.fs.writeAllOrRaise(&mut file, byte)
        index = index + 1
    }
    std.fs.close(&mut file)
}

fn fetch_to_file(client: HttpClient, url: String, path: String) -> Bool raises {
    var response: [131072]u8 = [0; 131072]
    let result: HttpResult = std.http.fetch(client, url, response, std.time.seconds(30))
    if !std.http.resultOk(result) {
        return false
    }
    if std.http.resultStatus(result) != 200 {
        return false
    }
    check write_http_body(path, response, result)
    return true
}

fn fetch_raw_to_file(client: HttpClient, owner: String, repo: String, source_path: String, target_path: String) -> Bool raises {
    var url_a: [512]u8 = [0; 512]
    var url_b: [512]u8 = [0; 512]
    var url_c: [512]u8 = [0; 512]
    let a: Maybe<String> = std.path.join(url_a, "https://raw.githubusercontent.com", owner)
    if !a.has {
        return false
    }
    let b: Maybe<String> = std.path.join(url_b, a.value, repo)
    if !b.has {
        return false
    }
    let c: Maybe<String> = std.path.join(url_c, b.value, source_path)
    if !c.has {
        return false
    }
    return check fetch_to_file(client, c.value, target_path)
}

fn fetch_registry_to_file(client: HttpClient, registry_path: String, target_path: String) -> Bool raises {
    var url_a: [512]u8 = [0; 512]
    let url: Maybe<String> = std.path.join(url_a, "https://raw.githubusercontent.com/zerolang-labs/zkg/refs/heads/main/registry", registry_path)
    if !url.has {
        return false
    }
    return check fetch_to_file(client, url.value, target_path)
}

fn first_line(buf: Span<u8>, len: usize) -> String {
    var end: usize = 0
    while end < len && buf[end] != 10 && buf[end] != 13 {
        end = end + 1
    }
    return buf[0..end]
}

fn write_package_record(owner: String, repo: String) -> Void raises {
    ensure_dir(".zkg")
    ensure_dir(".zkg/packages")
    var owner_dir_buf: [256]u8 = [0; 256]
    var metadata_buf: [256]u8 = [0; 256]
    let owner_dir: Maybe<String> = std.path.join(owner_dir_buf, ".zkg/packages", owner)
    if !owner_dir.has {
        return
    }
    ensure_dir(owner_dir.value)
    let metadata_path: Maybe<String> = std.path.join(metadata_buf, owner_dir.value, repo)
    if !metadata_path.has {
        return
    }
    let fs: Fs = std.fs.host()
    var file: owned<File> = check std.fs.createOrRaise(fs, metadata_path.value)
    check write_chunk(&mut file, "{\"module\":\"zkg.")
    check write_chunk(&mut file, owner)
    check write_chunk(&mut file, ".")
    check write_chunk(&mut file, repo)
    check write_chunk(&mut file, "\"}\n")
    std.fs.close(&mut file)
}

fn add_url_as(world: World, url: String, source_owner: String, source_repo: String, module_owner: String, module_repo: String) -> Void raises {
    ensure_dir("src")
    ensure_dir("src/zkg")
    ensure_dir(".zkg")
    ensure_dir(".zkg/cache")

    var owner_dir_buf: [256]u8 = [0; 256]
    var module_dir_buf: [256]u8 = [0; 256]
    var mod_path_buf: [256]u8 = [0; 256]
    let owner_dir: Maybe<String> = std.path.join(owner_dir_buf, "src/zkg", module_owner)
    if !owner_dir.has {
        check world.err.write("zkg: owner path too long\n")
        return
    }
    ensure_dir(owner_dir.value)
    let module_dir: Maybe<String> = std.path.join(module_dir_buf, owner_dir.value, module_repo)
    if !module_dir.has {
        check world.err.write("zkg: module path too long\n")
        return
    }
    ensure_dir(module_dir.value)
    let mod_path: Maybe<String> = std.path.join(mod_path_buf, module_dir.value, "mod.0")
    if !mod_path.has {
        check world.err.write("zkg: module entry path too long\n")
        return
    }

    let net: Net = std.net.host()
    let client: HttpClient = std.http.client(net)
    var installed: Bool = false
    if !installed {
        installed = check fetch_raw_to_file(client, source_owner, source_repo, "refs/heads/main/src/mod.0", mod_path.value)
    }
    if !installed {
        installed = check fetch_raw_to_file(client, source_owner, source_repo, "refs/heads/main/src/lib.0", mod_path.value)
    }
    if !installed {
        installed = check fetch_raw_to_file(client, source_owner, source_repo, "refs/heads/main/src/main.0", mod_path.value)
    }
    if !installed {
        check world.err.write("zkg: no src/mod.0, src/lib.0, or src/main.0 found over std.http\n")
        return
    }

    check write_package_record(module_owner, module_repo)
    check world.out.write("zkg: installed ")
    check world.out.write(url)
    check world.out.write(" as zkg.")
    check world.out.write(module_owner)
    check world.out.write(".")
    check world.out.write(module_repo)
    check world.out.write("\n")
}

fn add_url(world: World, url: String) -> Void raises {
    let owner_base: String = std.path.dirname(url)
    let owner: String = std.path.basename(owner_base)
    let repo: String = std.path.basename(url)
    check add_url_as(world, url, owner, repo, owner, repo)
}

fn add_alias(world: World, registry_name: String) -> Void raises {
    let net: Net = std.net.host()
    let client: HttpClient = std.http.client(net)
    ensure_dir(".zkg")
    ensure_dir(".zkg/cache")
    ensure_dir(".zkg/cache/registry")
    var alias_path_buf: [256]u8 = [0; 256]
    let alias_path: Maybe<String> = std.path.join(alias_path_buf, ".zkg/cache/registry", registry_name)
    if !alias_path.has {
        check world.err.write("zkg: alias path too long\n")
        return
    }
    let fetched: Bool = check fetch_registry_to_file(client, registry_name, alias_path.value)
    if !fetched {
        check world.err.write("zkg: registry alias not found: ")
        check world.err.write(registry_name)
        check world.err.write("\n")
        return
    }
    var url_bytes: [512]u8 = [0; 512]
    let read: Maybe<usize> = std.fs.readBytes(alias_path.value, url_bytes)
    if !read.has {
        check world.err.write("zkg: registry alias could not be read\n")
        return
    }
    let url: String = first_line(url_bytes, read.value)
    let source_owner_base: String = std.path.dirname(url)
    let source_owner: String = std.path.basename(source_owner_base)
    let source_repo: String = std.path.basename(url)
    let registry_len: usize = std.mem.len(registry_name)
    var dot: usize = 0
    while dot < registry_len && registry_name[dot] != 46 {
        dot = dot + 1
    }
    if dot == 0 || dot >= registry_len - 1 {
        check world.err.write("zkg: expected registry alias like user.repo\n")
        return
    }
    let module_owner: String = registry_name[0..dot]
    let module_repo: String = registry_name[dot + 1..registry_len]
    check add_url_as(world, url, source_owner, source_repo, module_owner, module_repo)
}

pub fn add(world: World, spec: String) -> Void raises {
    if std.str.startsWith(spec, "https://") {
        check add_url(world, spec)
        return
    }
    check add_alias(world, spec)
}

pub fn install(world: World) -> Void raises {
    ensure_dir(".zkg")
    ensure_dir(".zkg/bin")
    ensure_dir(".zkg/packages")
    ensure_dir(".zkg/cache")
    check world.out.write("zkg: prepared .zkg using std.fs\n")
}

pub fn update(world: World) -> Void raises {
    let net: Net = std.net.host()
    let client: HttpClient = std.http.client(net)
    var target: [256]u8 = [0; 256]
    ensure_dir(".zkg")
    ensure_dir(".zkg/cache")
    let path: Maybe<String> = std.path.join(target, ".zkg/cache", "zkg.README.md")
    if path.has {
        let fetched: Bool = check fetch_to_file(client, "https://raw.githubusercontent.com/zerolang-labs/zkg/refs/heads/main/README.md", path.value)
        if fetched {
            check world.out.write("zkg: fetched latest metadata with std.http\n")
            return
        }
    }
    check world.err.write("zkg: update fetch failed\n")
}

pub fn search(world: World, query: String) -> Void raises {
    let net: Net = std.net.host()
    let client: HttpClient = std.http.client(net)
    ensure_dir(".zkg")
    ensure_dir(".zkg/cache")
    let fetched: Bool = check fetch_registry_to_file(client, "index.tsv", ".zkg/cache/registry-index.tsv")
    if !fetched {
        check world.err.write("zkg: registry index fetch failed\n")
        return
    }
    var bytes: [65536]u8 = [0; 65536]
    let read: Maybe<usize> = std.fs.readBytes(".zkg/cache/registry-index.tsv", bytes)
    if !read.has {
        check world.err.write("zkg: registry index could not be read\n")
        return
    }
    if std.mem.len(query) == 0 {
        check world.out.write(bytes[0..read.value])
        return
    }
    check world.out.write("namespace\turl\towner\n")
    var start: usize = 0
    while start < read.value {
        var end: usize = start
        while end < read.value && bytes[end] != 10 {
            end = end + 1
        }
        let line: String = bytes[start..end]
        if std.str.contains(line, query) {
            check world.out.write(line)
            check world.out.write("\n")
        }
        start = end + 1
    }
}

pub fn uninstall(world: World, command_name: String) -> Void raises {
    var command_path_buf: [256]u8 = [0; 256]
    let command_path: Maybe<String> = std.path.join(command_path_buf, ".zkg/bin", command_name)
    if command_path.has && std.fs.exists(command_path.value) {
        if std.fs.remove(command_path.value) {
            check world.out.write("zkg: uninstalled ")
            check world.out.write(command_name)
            check world.out.write("\n")
            return
        }
    }
    check world.err.write("zkg: command not installed\n")
}

pub fn remove(world: World, namespace: String) -> Void raises {
    var owner_dir_buf: [256]u8 = [0; 256]
    var module_dir_buf: [256]u8 = [0; 256]
    var mod_path_buf: [256]u8 = [0; 256]
    let namespace_len: usize = std.mem.len(namespace)
    var dot: usize = 0
    while dot < namespace_len && namespace[dot] != 46 {
        dot = dot + 1
    }
    if dot == 0 || dot >= namespace_len - 1 {
        check world.err.write("zkg: expected namespace like user.repo\n")
        return
    }
    let owner: String = namespace[0..dot]
    let repo: String = namespace[dot + 1..namespace_len]
    let owner_dir: Maybe<String> = std.path.join(owner_dir_buf, "src/zkg", owner)
    if !owner_dir.has {
        check world.err.write("zkg: expected namespace like user.repo\n")
        return
    }
    let module_dir: Maybe<String> = std.path.join(module_dir_buf, owner_dir.value, repo)
    if !module_dir.has {
        check world.err.write("zkg: expected namespace like user.repo\n")
        return
    }
    let mod_path: Maybe<String> = std.path.join(mod_path_buf, module_dir.value, "mod.0")
    if mod_path.has {
        if std.fs.exists(mod_path.value) {
            std.fs.remove(mod_path.value)
        }
    }
    if std.fs.removeDir(module_dir.value) {
        check world.out.write("zkg: removed ")
        check world.out.write(namespace)
        check world.out.write("\n")
        return
    }
    check world.err.write("zkg: namespace not installed\n")
}
